{
  "displayName": "SecvestKit",
  "name": "homebridge-secvest-kit",
  "version": "0.1.0",
  "description": "Make Abus Secvest devices available as Homekit accessories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismkaya/homebridge-secvest-kit.git"
  },
  "bugs": {
    "url": "https://github.com/ismkaya/homebridge-secvest-kit/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "abus",
    "secvest",
    "security"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
