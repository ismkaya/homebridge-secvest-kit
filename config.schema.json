{
  "pluginAlias": "SecvestKit",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "host": {
        "title": "Host",
        "type": "string",
        "required": true
      },
      "port": {
        "title": "Port",
        "type": "integer",
        "required": true,
        "default": "4433"
      },
      "username": {
        "title": "Username",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true
      },
      "securityPartitions": {
        "title": "Security partitions",
        "type": "array",
        "items": {
          "title": "Partition",
          "type": "integer",
          "pattern": "^[1-4]$"
        }
      },
      "accessoryPartitions": {
        "title": "Accessory partitions",
        "type": "array",
        "items": {
          "title": "Partition",
          "type": "integer",
          "pattern": "^[1-4]$"
        }
      },
      "zoneTypes": {
        "title": "Zone Types",
        "type": "object",
        "properties": {
          "zone": {
            "title": "Zone type",
            "type": "string",
            "oneOf": [{
                "title": "lock",
                "enum": [
                  "lock"
                ]
              },
              {
                "title": "motion sensor",
                "enum": [
                  "motion"
                ]
              },
              {
                "title": "water sensor",
                "enum": [
                  "water"
                ]
              },
              {
                "title": "smoke sensor",
                "enum": [
                  "smoke"
                ]
              }
            ]
          }
        }
      },
      "pollingIntervalSeconds": {
        "title": "Polling interval in seconds",
        "description": "How often the Secvest is queried (minimum 10 seconds). Overrides the deprecated 'pollingInterval' (minutes).",
        "type": "integer",
        "required": false,
        "default": 30,
        "minimum": 10
      },
      "pollingInterval": {
        "title": "Polling interval in minutes (deprecated)",
        "description": "Deprecated: use 'pollingIntervalSeconds' instead. Only used if 'pollingIntervalSeconds' is not set.",
        "type": "integer",
        "required": false,
        "minimum": 1
      },
      "pushover": {
        "title": "Pushover Configuration",
        "type": "object",
        "properties": {
          "notificationDelay": {
            "title": "Notification delay",
            "type": "integer",
            "required": true,
            "default": "15"
          },
          "ignoredZones": {
            "title": "Ignored zones",
            "type": "array",
            "items": {
              "title": "Zone",
              "type": "integer",
              "pattern": "^[1-4]$"
            }
          },
          "user": {
            "title": "user",
            "type": "string",
            "required": true
          },
          "token": {
            "title": "token",
            "type": "string",
            "required": true
          }

        }
      }
    }
  }
}
